{# templates/components/navbar/navbar.html.twig #}

{% set locale = app.request.attributes.get('_locale') %}

{% set currentPath = app.request.get('_route') %}

{% block page_navbar %}



        <style>

            nav {
                zoom: 1.5;
            }

            .me-auto-rtl {
                margin-left: auto !important;
            }
        </style>

        <nav class="navbar navbar-dark navbar-expand-lg navbar-dark bg-dark bg-gray-100 inset-x-0">

            <!-- Navbar content -->

            <div class="container-fluid">

                <a class="navbar-brand" href="#">{% trans from 'messages' %}app.nav.page.title{% endtrans %}</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#headerNavbar" aria-controls="headerNavbar" aria-expanded="false" aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse justify-content-end text-right" id="headerNavbar">

                    {% if locale == 'ar' %} <!-- ARABIC  -->

                        <ul class="navbar-nav nav-item-label-rtl me-auto-rtl mb-2 mb-lg-0 nav-pages-elements">

                            {% if app.user %}

                                {% if currentPath is not same as('app_home_page') %}

                                    <li class="nav-item">

                                        <a class="nav-link active" aria-current="page" href="{{ path('app_home_page')}}">{% trans from 'messages' %}app.navbar.home{% endtrans %}</a>

                                    </li>

                                {% endif %}

                            {% else %}

                                <li class="nav-item">

                                    <a class="nav-link active" aria-current="page" href="{{ path('app_home_page')}}">{% trans from 'messages' %}app.navbar.home{% endtrans %}</a>

                                </li>

                            {% endif %}

                            {% if currentPath is not same as('app_user_page') %}

                                <li class="nav-item">

                                    {% if app.user %}
                                        <a class="nav-link active" aria-current="page" href="{{ path('app_devices')}}">{% trans from 'messages' %}app.navbar.devices{% endtrans %}</a>
                                    {% endif %}

                                </li>

                            {% endif %}

                        </ul>

                    {% else %} <!-- ENGLISH / FRENCH -->

                        <ul class="navbar-nav me-auto mb-2 mb-lg-0 nav-pages-elements justify-content-end">

                            {% if app.user %}

                                {% if currentPath is not same as('app_home_page') %}

                                    <li class="nav-item">

                                        <a class="nav-link active" aria-current="page" href="{{ path('app_home_page')}}">{% trans from 'messages' %}app.navbar.home{% endtrans %}</a>

                                    </li>

                                {% endif %}

                            {% else %}

                                <li class="nav-item">

                                    <a class="nav-link active" aria-current="page" href="{{ path('app_home_page')}}">{% trans from 'messages' %}app.navbar.home{% endtrans %}</a>

                                </li>

                            {% endif %}

                            {% if currentPath is not same as('app_devices') %}

                                <li class="nav-item">

                                    {% if app.user %}
                                        <a class="nav-link active" aria-current="page" href="{{ path('app_devices')}}">{% trans from 'messages' %}app.navbar.devices{% endtrans %}</a>
                                    {% endif %}

                                </li>

                            {% endif %}

                        </ul>

                    {% endif %}

                    {% if app.user %}

                        <ul class="navbar-nav" style="margin-left: 10px;">

                            <li class="nav-item nav-link">

                                <a class="dropdown-item" href="{{ path('app_user_profile')}}">{{ app.user.username }}</a>

                            </li>

                        </ul>

                    {% endif %}

                    <ul class="navbar-nav">

                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle" href="#" id="dropdown-language" role="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">

                                {{ app.request.locale|locale_name(app.request.locale) }}
                            </a>

                            <ul class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdown-language">

                                <li><a class="dropdown-item" href="{{ path(currentPath, {_locale: 'en', 'id': '0'}) }}">English</a></li>

                                <li><a class="dropdown-item" href="{{ path(currentPath, {_locale: 'ar', 'id': '0'}) }}">العربية</a></li>

                                <li><a class="dropdown-item" href="{{ path(currentPath, {_locale: 'fr', 'id': '0'}) }}">Français</a></li>

                            </ul>

                        </li>
                    </ul>

                    {% if not app.user %}

                        <ul class="navbar-nav nav-item-label-rtl">

                            {% if locale == 'ar' %} <!-- ARABIC  -->

                                <li class="nav-item">

                                    <a class="nav-link" aria-current="page" href="{{ path('app_user_login')}}">{% trans from 'messages' %}app.user_dropdown.login{% endtrans %}</a>

                                </li>

                                <li class="nav-item">

                                    <a class="nav-link" aria-current="page" href="{{ path('app_user_register')}}">{% trans from 'messages' %}app.user_dropdown.register{% endtrans %}</a>

                                </li>

                            {% else %}  <!-- ENGLISH / FRENCH  -->

                                <li class="nav-item">

                                    <a class="nav-link" aria-current="page" href="{{ path('app_user_login')}}">{% trans from 'messages' %}app.user_dropdown.login{% endtrans %}</a>

                                </li>

                                <li class="nav-item">

                                    <a class="nav-link" aria-current="page" href="{{ path('app_user_register')}}">{% trans from 'messages' %}app.user_dropdown.register{% endtrans %}</a>

                                </li>

                            {% endif %}

                        </ul>

                    {% else %}

                        <ul class="navbar-nav nav-item-label-rtl">

                            <li class="navbar-nav">

                                {% if locale == 'ar' %}

                                    <div class="dropend">

                                        <ul id="account_dropdown" class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink" data-popper-placement="left-start">

                                            {% if is_granted('ROLE_SUPER_ADMIN') or is_granted('ROLE_ADMIN') %}

                                                <a class="dropdown-item" href="{{ path('admin_dashboard')}}">{% trans from 'messages' %}app.navbar.administration{% endtrans %}</a>

                                            {% endif %}

                                            {% if app.user %}

                                                {% if currentPath is not same as('app_user_profile') %}

                                                    <a class="dropdown-item" href="{{ path('app_user_profile')}}">{% trans from 'messages' %}app.navbar.profile{% endtrans %}</a>

                                                {% endif %}

                                            {% endif %}

                                            <a class="dropdown-item" href="{{ path('app_home_page')}}">{% trans from 'messages' %}app.navbar.home{% endtrans %}</a>

                                            <a class="dropdown-item" href="{{ path('app_logout') }}">{% trans from 'messages' %}app.user_dropdown.logout{% endtrans %}</a>

                                        </ul>

                                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownMenuLink" data-bs-placement="left" role="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="true">

                                            <img src="https://s3.eu-central-1.amazonaws.com/bootstrapbaymisc/blog/24_days_bootstrap/fox.jpg" width="40" height="40" class="rounded-circle">

                                        </a>

                                    </div>

                                {% else %}

                                    <div class="dropstart">

                                        <ul id="account_dropdown" class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink" data-popper-placement="left-start">

                                            {% if is_granted('ROLE_SUPER_ADMIN') or is_granted('ROLE_ADMIN') %}

                                                <a class="dropdown-item" href="{{ path('admin_dashboard')}}">{% trans from 'messages' %}app.navbar.administration{% endtrans %}</a>

                                            {% endif %}

                                            {% if app.user %}

                                                {% if currentPath is not same as('app_user_profile') %}

                                                    <a class="dropdown-item" href="{{ path('app_user_profile')}}">{% trans from 'messages' %}app.user_dropdown.profile{% endtrans %}</a>

                                                {% else%}

                                                    <a class="dropdown-item" href="{{ path('app_home_page')}}">{% trans from 'messages' %}app.navbar.home{% endtrans %}</a>

                                                {% endif %}

                                            {% endif %}


                                            <hr class="menu-divider">

                                            <a class="dropdown-item" href="{{ path('app_user_settings') }}">{% trans from 'messages' %}app.user_dropdown.settings{% endtrans %}</a>

                                            <hr class="menu-divider">

                                            <a class="dropdown-item" href="{{ path('app_logout') }}">{% trans from 'messages' %}app.user_dropdown.logout{% endtrans %}</a>

                                        </ul>

                                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownMenuLink" data-bs-placement="left" role="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="true">

                                            <img src="https://s3.eu-central-1.amazonaws.com/bootstrapbaymisc/blog/24_days_bootstrap/fox.jpg" width="40" height="40" class="rounded-circle">

                                        </a>

                                    </div>

                                {% endif %}

                            </li>

                        </ul>

                    {% endif %}

                </div>

            </div>

        </nav>

        <script type="text/javascript">
        console.log("Navbar working");
    </script>


{% endblock page_navbar %}
