{% extends 'base.html.twig' %}

{% block title %}{% trans from 'messages' %}app.devices.page.title{% endtrans %}{% endblock %}

{% block body %}

    <style>
        section {
            background-color: {{site_settings.site_style.styleData.style.pages.devices.background_color}}
        }

        button {
            text-color: {{site_settings.site_style.styleData.style.pages.devices.background_color}}
        }

    </style>

    <div class="container-fluid">

        <div class="row">
            <section>
                <div class="row">

                    <div class="col-xs-12 col-sm-12  col-md-12  col-lg-12  col-xl-2  col-xxl-2">

                        <div class="add-device-button-container">

                            <button type="button" class="btn btn-outline-primary">+</button>
                        </div>

                    </div>

                    <div class="col-xs-12 col-sm-12  col-md-12  col-lg-12  col-xl-2  col-xxl-2">

                    </div>

                    <div class="col-xs-12 col-sm-12  col-md-12  col-lg-12  col-xl-2  col-xxl-2">

                    </div>
                </div>
            </section>
        </div>

    </div>

{% endblock %}
