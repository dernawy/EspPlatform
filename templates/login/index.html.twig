{% extends 'base.html.twig' %}
{% set locale = app.request.attributes.get('_locale') %}

{% block title %}{% trans from 'messages' %}app.login.page.title{% endtrans %}{% endblock %}

{% block body %}

    <style>

        body {
        //background-image: url({{ asset('media/images/site/backgrounds/al-quds-1.jpeg') }}) !important;
            background-repeat: no-repeat;
            background-attachment: fixed;
            background-size: cover;
        }

        body,html {
            height: 100%;
        }

        .login-form-container {
            width: 90%;
            margin: 0 auto;
        }
    </style>

    <div class="container-fluid">

        <div class="row">

            <div class="col-md-12 d-flex justify-content-center">

                {% if locale == 'ar' %}

                    <div class="login-page-label-rtl d-flex justify-content-center align-items-center label-sized-rtl">

                        {% trans from 'messages' %}app.login.user.form.label{% endtrans %}

                    </div>

                {% else %}

                    <div class="login-page-label d-flex justify-content-center align-items-center label-sized">

                        {% trans from 'messages' %}app.login.user.form.label{% endtrans %}

                    </div>

                {% endif %}

            </div>

        </div>

        <div class="row">

            <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 col-xxl-5">

            </div>

            <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 col-xxl-2">

                <div class="login-form-container">

                    <div class="pl-register-hello-alert-div">

                        <div id="id-user-hello-alert" class="alert alert-{{ style.alerts.type }}" role="alert">
                            {% trans from 'messages' %}app.login.user.form.label{% endtrans %}
                        </div>

                    </div>

                    <form action="{{ path('app_user_login') }}" method="post">

                        {% if error %}
                            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                        {% endif %}

                        {% if locale == 'ar' %}

                            <div class="form-floating mb-3">

                                <input type="text" value="{{ last_username }}" name="username" id="login_username" class="form-control" autocomplete="username" placeholder="Username" required >
                                <label for="login_username" class="form-label pl-input-label-rtl" id="l_username">{% trans from 'messages' %}app.login.form.username.label{% endtrans %}</label>

                            </div>

                            <div class="form-floating mb-3">

                                <input type="password" name="password" id="login_password" class="form-control" autocomplete="current-password" placeholder="Password" required >
                                <label for="login_password" class="form-label pl-input-label-rtl" id="l_password">{% trans from 'messages' %}app.login.form.password.label{% endtrans %}</label>

                            </div>

                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                            <div class="form-check form-switch mb-3">
                                <label for="remember-rme-check" class="color-label pl-input-label-rtl">
                                    {% trans from 'messages' %}app.login.form.remember.me.label{% endtrans %}
                                    <input id="remember-rme-check" class="form-check-input" type="checkbox" name="_remember_me" style="margin: 10px 10px; background-color: #008000;">
                                </label>
                            </div>

                        {% else %}

                            <div class="form-floating mb-3">

                                <input type="text" value="{{ last_username }}" name="username" id="login_username" class="form-control" autocomplete="username" placeholder="Username" required>
                                <label for="login_username" class="form-label pl-input-label" id="l_username">{% trans from 'messages' %}app.login.form.password.label{% endtrans %}</label>

                            </div>

                            <div class="form-floating mb-3">

                                <input type="password" name="password" id="login_password" class="form-control" autocomplete="current-password" placeholder="Password" required>
                                <label for="login_password" class="form-label pl-input-label" id="l_password">{% trans from 'messages' %}app.login.form.password.label{% endtrans %}</label>

                            </div>

                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                            <div class="form-check form-switch mb-3" style="padding-left: 0 !important;">
                                <label for="remember-rme-check" class="color-label">
                                    <input id="remember-rme-check" class="form-check-input" type="checkbox" name="_remember_me" style="margin: 5px 10px; background-color: #008000;">
                                    {% trans from 'messages' %}app.login.form.remember.me.label{% endtrans %}
                                </label>
                            </div>

                            <div class="checkbox mb-3">
                                <a class="pl-input-label white-label" href="{{ path('app_forgot_password_request') }}">Forgot Password</a>
                            </div>

                        {% endif %}

                        <br>

                        <button class="form-control btn btn-lg btn-primary pl-button-label-rtl" type="submit">{% trans from 'messages' %}app.login.form.login.button.label{% endtrans %}</button>

                    </form>

                </div>
            </div>

            <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 col-xxl-5">

            </div>

        </div>

    </div>

{% endblock %}
