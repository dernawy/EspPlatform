{% extends 'base.html.twig' %}
{% set locale = app.request.attributes.get('_locale') %}

{% block title %}Hello RegisterController!{% endblock %}

{% block body %}

    <style>
        body {
            background-color: #1a1d20;
        }

        .invalid-feedback {
            position: relative !important;
        }

        .carousel-centred {
            width: 90%;
            margin: 0 auto;
        }

        .register-button-cadre{
            margin: 0 auto;
            width: 16%;
            font-family: 'Cairo',sans-serif;
        }

        .page-alert { margin-top: 0;}
    </style>

    <script type="module">
        $( document ).ready(function() {
            $('#myTab a').on('click', function (e) {
                e.preventDefault()
                $(this).tab('show')
            })
        });
    </script>

    <div class="container-fluid">

        <div class="row">

            {% if locale == 'ar' %}

                <div class="justify-content-center align-items-center label-sized-rtl">

                    {% trans from 'messages' %}app.register.page.title{% endtrans %}

                </div>

            {% else %}

                <div class="centred-height-20 d-flex justify-content-center align-items-center label-sized">

                    {% trans from 'messages' %}app.register.page.title{% endtrans %}

                </div>

            {% endif %}

        </div>

        <div class="row">

            <div class="container">

                <div class="row">

                    <div class="col-md-12 col-sm-12 col-xs-12 col-lg-12 col-xl-12 col-xxl-4">

                        <div class="row">

                            <div class="register-carousel-cadre">

                                <div id="register_carousel" class="carousel slide carousel-centred" data-bs-ride="carousel">

                                    <!-- Indicators/dots -->
                                    <div class="carousel-indicators">

                                        <button type="button" data-bs-target="#register_carousel" data-bs-slide-to="0" class="active"></button>
                                        <button type="button" data-bs-target="#register_carousel" data-bs-slide-to="1"></button>
                                        <button type="button" data-bs-target="#register_carousel" data-bs-slide-to="2"></button>

                                    </div>

                                    <!-- The slideshow/carousel -->
                                    <div class="carousel-inner">

                                        <div class="carousel-item active">

                                            <img class="d-block w-100" height="500px" src="{{ asset('media/images/slides/register/palestine-1.jpg') }}" alt="First slide">

                                            <div class="carousel-caption d-none d-md-block">
                                                <h5>First slide label</h5>
                                                <p>Some representative placeholder content for the first slide.</p>
                                            </div>

                                        </div>

                                        <div class="carousel-item">

                                            <img class="d-block w-100" height="500px" src="{{ asset('media/images/slides/register/palestine-2.jpg') }}" alt="Second slide">

                                            <div class="carousel-caption d-none d-md-block">
                                                <h5>Second slide label</h5>
                                                <p>Some representative placeholder content for the second slide.</p>
                                            </div>

                                        </div>

                                        <div class="carousel-item">

                                            <img class="d-block w-100" height="500px" src="{{ asset('media/images/slides/register/Palestine-3.jpg') }}" alt="Third slide">

                                            <div class="carousel-caption d-none d-md-block">
                                                <h5>Third slide label</h5>
                                                <p>Some representative placeholder content for the third slide.</p>
                                            </div>

                                        </div>

                                    </div>

                                    <!-- Left and right controls/icons -->
                                    <button class="carousel-control-prev" type="button" data-bs-target="#register_carousel" data-bs-slide="prev">
                                        <span class="carousel-control-prev-icon"></span>
                                    </button>

                                    <button class="carousel-control-next" type="button" data-bs-target="#register_carousel" data-bs-slide="next">
                                        <span class="carousel-control-next-icon"></span>
                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-12 col-sm-12 col-xs-12 col-lg-12 col-xl-12 col-xxl-4 d-flex justify-content-center align-items-center">

                        <div class="col-sm-{{ style.form.width }}">

                            {% if user_level == 'USER' %}

                                {% form_theme user_form 'form_inputs/input_row.html.twig' %}

                                {{ form_start(user_form, {'attr': {'novalidate': 'novalidate'}}) }}

                                {% if locale == 'ar' %}

                                    {{ form_row(user_form.full_name, {'label_attr': {'class': 'pl-input-label-rtl'}}) }}

                                    {{ form_row(user_form.username, {'label_attr': {'class': 'pl-input-label-rtl'}}) }}

                                    {{ form_row(user_form.user_email, {'label_attr': {'class': 'pl-input-label-rtl'}}) }}

                                    {{ form_row(user_form.password, {'label_attr': {'class': 'pl-input-label-rtl'}}) }}

                                    {{ form_row(user_form.phone, {'label_attr': {'class': 'pl-input-label-rtl'}}) }}

                                    {{ form_row(user_form.termsAccepted, {'attr': {'class':'pl-terms-input-rtl'}, 'label_attr': {'class': 'pl-input-label-rtl'}}) }}

                                {% else %}

                                    {{ form_row(user_form.full_name, {'label_attr': {'class': ''}}) }}

                                    {{ form_row(user_form.username, {'label_attr': {'class': ''}}) }}

                                    {{ form_row(user_form.user_email, {'label_attr': {'class': ''}}) }}

                                    {{ form_row(user_form.password, {'label_attr': {'class': ''}}) }}

                                    {{ form_row(user_form.phone, {'label_attr': {'class': ''}}) }}

                                    <br>

                                    {{ form_row(user_form.termsAccepted, {'attr': {'class':'pl-terms-input'}, 'label_attr': {'class': 'pl-input-label'}}) }}

                                {% endif %}

                                <div class="register-button-cadre">
                                    {{ form_widget(user_form.register) }}
                                </div>
                                <br><br><br><br>

                                {{ form_end(user_form) }}

                            {% endif %}

                            {% if user_level == 'EDITOR' %}

                            {% endif %}

                            {% if user_level == 'MODERATOR' %}

                            {% endif %}

                            {% if user_level == 'MANAGER' %}

                            {% endif %}

                        </div>
                    </div>

                    <div class="col-md-12 col-sm-12 col-xs-12 col-lg-12 col-xl-12 col-xxl-4">

                        <div class="row">

                            <div class="register-card-cadre">

                                <div class="card card w-100 bg-light text-center mb-5">

                                    <div class="card-header">

                                        <ul class="nav nav-tabs" id="myTab" role="tablist">

                                            {% if locale == 'ar' %}

                                                <li class="nav-item">
                                                    <button class="nav-link nav-item-label-rtl active" id="home-tab" data-bs-toggle="tab" data-bs-target="#home" type="button" role="tab" aria-controls="home" aria-selected="true">{% trans from 'messages' %}application.register.tabs.who.we.are.label{% endtrans %}</button>
                                                </li>

                                                <li class="nav-item">
                                                    <button class="nav-link nav-item-label-rtl" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile" type="button" role="tab" aria-controls="profile" aria-selected="false">{% trans from 'messages' %}application.register.tabs.contact.us.label{% endtrans %}</button>
                                                </li>

                                                <li class="nav-item">

                                                    <button class="nav-link nav-item-label-rtl" id="contact-tab" data-bs-toggle="tab" data-bs-target="#contact" type="button" role="tab" aria-controls="contact" aria-selected="false">{% trans from 'messages' %}application.register.tabs.support.label{% endtrans %}</button>
                                                </li>

                                            {% else %}

                                                <li class="nav-item">
                                                    <button class="nav-link" id="home-tab" data-bs-toggle="tab" data-bs-target="#home" type="button" role="tab" aria-controls="home" aria-selected="true">{% trans from 'messages' %}application.register.tabs.who.we.are.label{% endtrans %}</button>
                                                </li>

                                                <li class="nav-item">
                                                    <button class="nav-link" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile" type="button" role="tab" aria-controls="profile" aria-selected="false">{% trans from 'messages' %}application.register.tabs.contact.us.label{% endtrans %}</button>
                                                </li>

                                                <li class="nav-item">

                                                    <button class="nav-link" id="contact-tab" data-bs-toggle="tab" data-bs-target="#contact" type="button" role="tab" aria-controls="contact" aria-selected="false">{% trans from 'messages' %}application.register.tabs.support.label{% endtrans %}</button>
                                                </li>

                                            {% endif %}
                                        </ul>

                                    </div>

                                    <div class="card-body">

                                        <div class="tab-content" id="myTabContent">

                                            <div class="tab-pane fade show active" id="home" role="tabpanel" aria-labelledby="home-tab">{% trans from 'messages' %}application.register.tabs.who.we.are.text{% endtrans %}</div>
                                            <div class="tab-pane fade" id="profile" role="tabpanel" aria-labelledby="profile-tab">Profile</div>
                                            <div class="tab-pane fade" id="contact" role="tabpanel" aria-labelledby="contact-tab">Contact</div>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                        <div class="row">

                            <div class="register-card-cadre">

                                <div class="card w-100 text-white bg-primary mb-3">
                                    {% if locale == 'ar' %}
                                        <div class="card-header nav-item-label-rtl">{% trans from 'messages' %}application.register.text.word.announce.label{% endtrans %}</div>
                                    {%  else %}
                                        <div class="card-header nav-item-label">{% trans from 'messages' %}application.register.text.word.announce.label{% endtrans %}</div>
                                    {% endif %}
                                    <div class="card-body">
                                        <h5 class="card-title">{% trans from 'messages' %}application.register.text.word.announce.sub.label{% endtrans %}</h5>
                                        <p class="card-text">{% trans from 'messages' %}application.register.text.word.announce.text{% endtrans %}</p>
                                    </div>
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

{% endblock %}
